# Local production-like stack (docker-compose.prod.yml)
# Copy to .env at repo root:  cp .env.local-prod.example .env
# Do not commit .env. For VPS/production use unique secrets.

# Database (internal to compose; host ports not exposed)
POSTGRES_DB=ai_sales_os
POSTGRES_USER=ai_sales_os
POSTGRES_PASSWORD=local-prod-postgres-change-me
# Overridden inside compose to postgres:5432
DATABASE_URL=postgres://ai_sales_os:local-prod-postgres-change-me@postgres:5432/ai_sales_os

# Redis (internal; overridden inside compose)
REDIS_URL=redis://redis:6379/0

# Django — production mode locally (no TLS; access via http://127.0.0.1:3000)
DJANGO_ENV=production
DJANGO_SECRET_KEY=local-prod-secret-key-min-32-chars-change-me
DJANGO_DEBUG=false
DJANGO_SECURE=false
DJANGO_ALLOWED_HOSTS=api,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Next.js BFF — same-origin cookies through web on localhost
NEXT_PUBLIC_API_URL=
API_BACKEND_URL=http://api:8000
WEB_PORT=3000

# Password reset — must match browser origin (https://your-domain on VPS)
FRONTEND_URL=http://127.0.0.1:3000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Fernet-compatible placeholder for encrypted tenant credentials in Admin
# Generate a real key before storing production integration secrets.
AI_CREDENTIALS_KEY=local-prod-credentials-placeholder-32chars

# Demo users (optional — run seed_demo manually for login smoke):
# manager@demo.local / demo1234  → /manager
# employee@demo.local / demo1234 → /employee

# AI / LLM (optional for Gate A health smoke)
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_CHAT_MODEL=openai/gpt-4o-mini
LLM_EMBEDDING_MODEL=openai/text-embedding-3-small
LLM_EMBEDDING_DIMENSIONS=1536

# Data retention
TRANSCRIPT_RETENTION_DAYS=90
AGENT_CHAT_RETENTION_DAYS=90

# Speech-to-text
STT_MODEL=openai/whisper-1

# CRM sync interval (minutes)
CRM_SYNC_INTERVAL_MINUTES=60

# Optional error reporting (disabled when unset)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=local-prod
# SENTRY_TRACES_SAMPLE_RATE=0
