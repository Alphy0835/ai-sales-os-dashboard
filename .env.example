# Database
POSTGRES_DB=ai_sales_os
POSTGRES_USER=ai_sales_os
POSTGRES_PASSWORD=ai_sales_os_local
DATABASE_URL=postgres://ai_sales_os:ai_sales_os_local@localhost:5432/ai_sales_os

# Redis
REDIS_URL=redis://localhost:6379/0

# Django
DJANGO_SECRET_KEY=change-me-in-production-use-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000

# Demo users (created by: python manage.py seed_demo)
# manager@demo.local / demo1234  → /manager
# employee@demo.local / demo1234 → /employee
