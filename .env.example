# Database
POSTGRES_DB=ai_sales_os
POSTGRES_USER=ai_sales_os
POSTGRES_PASSWORD=ai_sales_os_local
DATABASE_URL=postgres://ai_sales_os:ai_sales_os_local@localhost:5432/ai_sales_os

# Redis (Celery broker + Django cache for DRF throttling when set; tests use in-memory cache)
REDIS_URL=redis://localhost:6379/0

# Django
# Local dev: leave DJANGO_ENV unset (or development) and DJANGO_DEBUG=true.
# Production: set DJANGO_ENV=production (or DJANGO_DEBUG=false); SECRET_KEY is required (>= 32 chars).
DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me-in-production-use-long-random-string
DJANGO_DEBUG=true
# Enable HTTPS security headers/cookies (also auto-enabled when DJANGO_ENV=production)
DJANGO_SECURE=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Next.js BFF — browser uses same-origin /api/v1 (Next rewrites to Django)
# Local dev: leave NEXT_PUBLIC_API_URL empty; API_BACKEND_URL points at local Django.
# Production (docker-compose.prod.yml): keep NEXT_PUBLIC_API_URL empty (same-origin cookies);
# compose sets API_BACKEND_URL=http://api:8000 and bakes both into the web image at build time.
NEXT_PUBLIC_API_URL=
API_BACKEND_URL=http://localhost:8000
# Password reset links (required on VPS — set to your public origin; also used for Admin registration_url)
FRONTEND_URL=http://localhost:3000
# Local dev: log reset links to console. Production: configure SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# CSRF trusted origins (defaults to CORS_ALLOWED_ORIGINS); required for cross-origin admin
# CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Demo users (created by: python manage.py seed_demo)
# manager@demo.local / demo1234  → /manager
# employee@demo.local / demo1234 → /employee

# AI / LLM (OpenRouter-compatible)
# Set OPENROUTER_API_KEY to enable agent LLM replies, embeddings, and STT (global fallback).
# Per-tenant overrides: Django Admin → AI → Tenant AI configs (encrypted API key, model_tier).
#   model_tier presets: free | standard (default) | premium — see ai/services/model_tiers.py
#   Workspace AI configs: optional tier/key override per workspace (blank tier inherits tenant).
# LLM_* below are env fallbacks when Admin config is absent or tier preset leaves embedding empty (free tier).
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_CHAT_MODEL=openai/gpt-4o-mini
LLM_EMBEDDING_MODEL=openai/text-embedding-3-small
LLM_EMBEDDING_DIMENSIONS=1536
# Fernet key for encrypted tenant/workspace API keys in Django Admin (required in production)
AI_CREDENTIALS_KEY=

# Data retention
TRANSCRIPT_RETENTION_DAYS=90
AGENT_CHAT_RETENTION_DAYS=90

# Speech-to-text (OpenRouter-compatible, same key as LLM)
STT_MODEL=openai/whisper-1

# Optional error reporting (API only; no-op when unset; disabled during tests)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0

# Google Sheets CRM (P4b-GS / P4c)
# Per-tenant service account JSON is stored encrypted in Django Admin
# (IntegrationSource.credentials_encrypted) — recommended for production.
# Optional dev shortcut: path to a shared service-account JSON file on disk.
# GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
# Background CRM sync interval (minutes). Beat + login throttle use this value. Default: 60.
CRM_SYNC_INTERVAL_MINUTES=60
